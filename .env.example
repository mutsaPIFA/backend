# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올라가지 않는다.
#   cp .env.example .env

# DB
DB_USERNAME=mcmmuse
DB_PASSWORD=mcmmuse

# JWT 서명 키 — 최소 32바이트. 아래 명령으로 생성:
#   openssl rand -base64 48
JWT_SECRET=

# AI 서비스 (mock | http) — 키가 없어도 mock 으로 개발 진행 가능
APP_AI_MODE=mock

# Gemini (AI 담당) — ai 서비스가 사용
GEMINI_API_KEY=
