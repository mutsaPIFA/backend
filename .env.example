# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올라가지 않는다.
#   cp .env.example .env
# docker compose가 이 폴더의 .env 를 자동으로 읽는다.
# ※ GEMINI_API_KEY 는 여기가 아니라 ../ai/.env 에 둔다 (compose가 ai 컨테이너에 자동 주입).

# DB
DB_USERNAME=mcmmuse
DB_PASSWORD=mcmmuse

# JWT 서명 키 — 로컬은 생략 가능(compose 기본값), 배포에선 필수 교체:
#   openssl rand -base64 48
#JWT_SECRET=

# 배포 시 이미지 절대 URL의 베이스 (계약 Q8) — 공인IP 또는 도메인으로
#APP_STORAGE_PUBLIC_BASE_URL=http://<공인IP>/images

# AI 포트별 스위치 (mock | http) — compose 기본값은 http.
# 키 없이 돌리려면 전부 mock (스캔·코디가 목업 데이터로 동작)
#APP_AI_CUTOUT=http
#APP_AI_TAGGING=http
#APP_AI_STANDARDIZE=http
#APP_AI_OUTFIT_IMAGE=http
#APP_AI_OUTFIT_COMPOSE=http
#APP_AI_RECOMMEND=http
